# Copy to .env.local (never committed) and fill in what you use. Everything is optional:
# with no keys Threadline runs in deterministic mode on an embedded database.

# --- Database -------------------------------------------------------------------------
# PostgreSQL 16 (local, Supabase, or any managed Postgres). Leave unset to use the
# embedded PGlite database stored under THREADLINE_DATA_DIR.
DATABASE_URL=
# Separate server/database used by `npm test` (a scratch database is created per test file).
TEST_DATABASE_URL=
# Where the embedded database, private file store and session secret live. Default: .data
THREADLINE_DATA_DIR=

# --- Sessions -------------------------------------------------------------------------
# 32+ random bytes, e.g. `openssl rand -hex 32`. Required in production.
SESSION_SECRET=
# "1" shows one-click demo sign-in for the synthetic accounts. Set to "0" for any real data.
THREADLINE_DEMO_LOGIN=1

# --- AI providers (server-side only; never exposed to the browser) ----------------------
# Reasoning model for Ask Your Building. Without it, answers are composed deterministically.
ANTHROPIC_API_KEY=
THREADLINE_REASONING_MODEL=claude-opus-5-5
# Optional server-side transcription / speech. Without it, voice uses the browser's own
# speech recognition and synthesis.
OPENAI_API_KEY=
THREADLINE_TRANSCRIBE_MODEL=
THREADLINE_TTS_MODEL=
